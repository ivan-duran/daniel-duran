---
const siteName = "Daniel Durán Vilches";
const role = "Periodista";

const navItems = [
  { label: "Bitácora", href: "#bitacora" },
  { label: "Servicios", href: "#servicios" },
  { label: "Contacto", href: "#contacto" },
];

const socials = [
  { name: "Instagram", url: "https://instagram.com/danielduranvilches" },
  { name: "LinkedIn", url: "https://www.linkedin.com/in/danielduranvilches" },
];
---

<header class="main-header">
  <div class="header-inner">
    <div class="brand">
      <a href="/" class="logo">
        {siteName}
      </a>
      <span class="role">{role}</span>
    </div>

    <div class="nav-group">
      <nav class="site-nav" aria-label="Navegacion principal">
        {navItems.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>

      <nav class="social-nav" aria-label="Redes sociales">
        {socials.map((social) => (
          <a href={social.url} target="_blank" rel="noopener noreferrer">
            {social.name}
          </a>
        ))}
      </nav>
    </div>
  </div>
</header>

<style>
  .main-header {
    width: 100%;
    padding: 1rem var(--page-padding) 0;
    background: rgba(0, 0, 0, 0.78);
    position: sticky;
    top: 0;
    z-index: 1000;
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line-soft);
  }

  .brand {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 12rem;
  }

  .logo {
    font-size: clamp(1rem, 1.7vw, 1.45rem);
    font-weight: 760;
    text-decoration: none;
    color: var(--color-text-strong);
    text-transform: uppercase;
    letter-spacing: 0;
    transition: color 0.2s ease;
  }

  .logo:hover {
    color: var(--color-accent);
  }

  .role {
    font-size: 0.78rem;
    font-weight: 560;
    text-transform: uppercase;
    letter-spacing: 0;
    color: var(--color-text-muted);
  }

  .nav-group,
  .site-nav,
  .social-nav {
    display: flex;
    align-items: center;
  }

  .nav-group {
    gap: clamp(1rem, 3vw, 3rem);
  }

  .site-nav {
    gap: clamp(0.9rem, 2vw, 1.8rem);
  }

  .social-nav {
    gap: clamp(0.75rem, 1.5vw, 1.3rem);
  }

  .site-nav a,
  .social-nav a {
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 620;
    text-transform: uppercase;
    letter-spacing: 0;
    opacity: 0.72;
    transition:
      color 0.2s ease,
      opacity 0.2s ease;
  }

  .site-nav a:hover,
  .social-nav a:hover {
    color: var(--color-accent);
    opacity: 1;
  }

  @media (max-width: 860px) {
    .header-inner {
      align-items: flex-start;
      flex-direction: column;
    }

    .nav-group {
      width: 100%;
      justify-content: space-between;
      gap: 1rem;
    }
  }

  @media (max-width: 620px) {
    .main-header {
      padding-top: 0.75rem;
    }

    .header-inner {
      gap: 0.75rem;
    }

    .logo {
      font-size: 1.08rem;
      line-height: 1.1;
    }

    .role {
      font-size: 0.65rem;
    }

    .nav-group {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.65rem;
    }

    .site-nav,
    .social-nav {
      width: 100%;
      justify-content: space-between;
      gap: 0.55rem;
    }

    .site-nav a,
    .social-nav a {
      font-size: 0.68rem;
    }
  }
</style>