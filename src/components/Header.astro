---
const siteName = "Daniel Durán Vilches";
const role = "Periodista";

const socials = [
  { name: "Instagram", url: "https://instagram.com/danielduranvilches" },
  { name: "LinkedIn", url: "https://www.linkedin.com/in/danielduranvilches" },
];
---

<header class="main-header">
  <div class="header-inner">
    
    <div class="brand">
      <a href="/" class="logo">
        {siteName}
      </a>
      <span class="role">{role}</span>
    </div>
    
    <nav class="social-nav">
      {socials.map((social) => (
        <a href={social.url} target="_blank" rel="noopener noreferrer">
          {social.name}
        </a>
      ))}
    </nav>

  </div>
</header>

<style>
  .main-header {
    width: 100%;
    /* Tu padding original */
    padding: 1.5rem var(--padding, 20px) 0rem; 
    
    /* Asegúrate de que el fondo sea sólido para que no se vea el texto mezclado al pasar por debajo */
    background-color: var(--bg-dark); 
    
    /* --- CÓDIGO NUEVO PARA FIJARLO --- */
    position: sticky;  /* Comportamiento "pegajoso" */
    top: 0;            /* Se pega al tocar el borde superior */
    z-index: 1000;     /* Asegura que quede por encima de las fotos y videos */
    
    /* Opcional: Un toque elegante (Blur) */
    /* Si tu variable --bg-dark tiene algo de transparencia, esto desenfoca lo que pasa por detrás */
    backdrop-filter: blur(10px); 
    -webkit-backdrop-filter: blur(10px); /* Para Safari */
  }

  .header-inner {
    display: flex;
    justify-content: space-between; /* Separa Marca a la izq y Redes a la der */
    align-items: center; /* Centrado vertical del bloque completo */
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }

  /* --- Estilos del Bloque de Marca --- */
  .brand {
    display: flex;
    flex-direction: column; /* Esto pone el rol DEBAJO del nombre */
    line-height: 1.1;       /* Mantiene el rol pegadito al nombre */
    gap: 2px;               /* Pequeño espacio extra si es necesario */
  }

  .logo {
    font-family: var(--font);
    font-size: 1.8rem;      /* Tamaño grande para el nombre */
    font-weight: 800;
    text-decoration: none;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    transition: color 0.2s ease;
  }

  .logo:hover {
    color: var(--color-accent);
  }

  .role {
    font-family: var(--font);
    font-size: 0.9rem;      /* Tamaño más pequeño para el rol */
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;  /* Espaciado elegante entre letras */
    color: rgba(255, 255, 255, 0.6); /* Color grisáceo */
  }

  /* --- Estilos de Redes Sociales --- */
  .social-nav {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .social-nav a {
    color: #ffffff;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: color 0.2s ease;
    opacity: 0.7;
  }

  .social-nav a:hover {
    color: var(--color-accent);
    opacity: 1;
  }

/* --- Responsive (Móvil) --- */
  @media (max-width: 600px) {
    .main-header {
      /* Padding compacto: arriba/abajo reducidos */
      padding: 0.8rem var(--padding, 20px) 0rem; 
    }

    .header-inner {
      /* Mantenemos 'row' para que queden lado a lado */
      flex-direction: row; 
      justify-content: space-between; /* Uno a cada extremo */
      align-items: center; /* Centrados verticalmente */
      gap: 1rem; /* Espacio mínimo entre nombre y botones */
      padding-bottom: 0.8rem;
    }
    
    .brand {
      /* Alineamos nombre y rol a la izquierda */
      align-items: flex-start; 
      text-align: left;
      /* Evita que el nombre se rompa feo si falta espacio */
      max-width: 60%; 
    }

    .logo {
      font-size: 1.1rem; /* Tamaño ajustado para que quepa en una línea o dos */
      line-height: 1.1;
    }
    
    .role {
      font-size: 0.65rem;
      margin-top: 2px;
    }

    /* Redes a la derecha */
    .social-nav {
      gap: 0.5rem; /* Botones más pegaditos entre sí */
      flex-wrap: nowrap; /* Forzamos que no bajen de línea */
    }

    .social-nav a {
      font-size: 0.6rem; /* Texto compacto */
      padding: 4px 8px;  /* Botones más pequeños */

    }
  }
</style>