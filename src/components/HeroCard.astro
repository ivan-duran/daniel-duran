---
// src/components/HeroCard.astro
import { Image } from "astro:assets";

interface Props {
  title: string;
  image: ImageMetadata; // Recibe la imagen importada
  eyebrow?: string; // El texto pequeño arriba
  link?: string; // A dónde lleva el botón
}

const { title, image, eyebrow, link = "#" } = Astro.props;
---

<div class="hero-card">
  <Image 
    src={image} 
    alt={title} 
    class="hero-bg" 
    width={1920} 
    quality={90}
  />

  <div class="overlay"></div>

  <div class="content">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    
    <h2 class="title">
      {title}
    </h2>
  </div>
</div>

<style>
  .hero-card {
    position: relative;
    width: 100%;
    /* Altura mínima para que se vea imponente */
    min-height: clamp(400px, 60vh, 700px); 
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    border-radius: var(--media-radius, 18px); /* Usamos tu variable global */
    text-align: center;
    margin-bottom: var(--space, 20px);
    isolation: isolate; /* Crea un nuevo contexto de apilamiento */
  }

  /* --- IMAGEN DE FONDO --- */
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  /* --- CAPA OSCURA (Overlay) --- */
  .overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4); /* Ajusta la opacidad según necesites */
    z-index: -1;
    transition: background 0.3s ease;
  }

  .hero-card:hover .overlay {
    background: rgba(0, 0, 0, 0.2); /* Se aclara un poco al pasar el mouse */
  }

  /* --- CONTENIDO --- */
  .content {
    color: #fff;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    z-index: 1;
  }

  .eyebrow {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    margin-bottom: -0.5rem;
  }

  .title {
    font-size: clamp(2rem, 5vw, 4rem); /* Texto responsivo grande */
    font-weight: 800;
    line-height: 1.1;
    text-transform: uppercase;
    color: #FDE047; /* Un amarillo similar al de tu referencia */
    margin: 0;
  }


  /* --- BOTÓN --- */
  .read-more {
    margin-top: 1rem;
    display: inline-block;
    padding: 10px 24px;
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 999px; /* Pill shape */
    color: #fff;
    text-decoration: none;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: all 0.3s ease;
    backdrop-filter: blur(4px);
  }

  .read-more:hover {
    background: #fff;
    color: #000;
    transform: translateY(-2px);
  }
</style>